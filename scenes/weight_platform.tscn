[gd_scene format=3 uid="uid://bvr3ntintd82c"]

[sub_resource type="GDScript" id="GDScript_q2wfu"]
script/source = "@tool
extends RigidBody2D
##
## Moving platform for Clockwork — slides along a rail between two
## endpoints. Two variants:
##   - \"Balloon\" — gravity_scale is negative, so the platform wants
##      to rise
##   - \"Weight\" — gravity_scale is 1, so the platform wants to fall
##
## Rail endpoints (rail_start, rail_end, starting_position) are exposed
## here as @exports so the level designer configures the rail in one
## place. A GrooveJoint2D under RotatingLevelComponents
## (scripts/rail_joint.gd) reads these via get_node(node_b) in its own
## _ready() and configures itself to constrain this platform to the
## rail. The joint inherits RotatingLevelComponents' rotation, so when
## the level rotates 90° the rail rotates with it; gravity / buoyancy
## (set via gravity_scale here) drives the platform along the rail
## naturally.
##

@export_enum(\"Balloon\", \"Weight\") var platform_type: String = \"Balloon\"

# Rail endpoints in RotatingLevelComponents' local frame (the joint
# reads these). The joint places itself at rail_start and aligns its
# local +Y axis with (rail_end - rail_start).
@export var rail_start: Vector2 = Vector2(0, 100)
@export var rail_end: Vector2 = Vector2(0, -100)

# Gravity / buoyancy magnitudes (px/s²). Applied as gravity_scale:
# positive for Weight (normal gravity), negative for Balloon (inverts
# direction for buoyancy).
@export var gravity: float = 980.0
@export var buoyancy: float = 1500.0

# Starting position along the rail. 0.0 = at rail_start; 1.0 = at
# rail_end. The joint reads this and sets its initial_offset.
@export_range(0.0, 1.0, 0.01) var starting_position: float = 0.0

# Collision shape + visual size. (64, 16) = long flat platform.
@export var platform_size: Vector2 = Vector2(64, 16)

# Mass of the platform. The body has a default mass; this lets the
# level designer tune it.
@export var mass_override: float = 1.0

@onready var collision_shape: CollisionShape2D = $CollisionShape2D
@onready var platform_visual: Polygon2D = $PlatformVisual


func _ready() -> void:
	# Apply gravity_scale based on platform_type. The GrooveJoint2D
	# (configured by scripts/rail_joint.gd under RotatingLevelComponents)
	# constrains this platform to the rail. Gravity / buoyancy drives
	# the platform along the rail naturally.
	match platform_type:
		\"Balloon\":
			if gravity > 0.0:
				gravity_scale = -buoyancy / gravity
		\"Weight\":
			gravity_scale = 1.0

	mass = mass_override
	lock_rotation = true  # prevent the platform from rotating

	# Configure the collision shape and visual to match platform_size.
	if collision_shape.shape is RectangleShape2D:
		(collision_shape.shape as RectangleShape2D).size = platform_size
	var half: Vector2 = platform_size * 0.5
	platform_visual.polygon = PackedVector2Array([
		Vector2(-half.x, -half.y),
		Vector2(half.x, -half.y),
		Vector2(half.x, half.y),
		Vector2(-half.x, half.y),
	])
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_platform"]
size = Vector2(64, 16)

[node name="WeightPlatform" type="RigidBody2D" unique_id=1600000003]
gravity_scale = -1.5306122
lock_rotation = true
script = SubResource("GDScript_q2wfu")

[node name="CollisionShape2D" type="CollisionShape2D" parent="." unique_id=1035712081]
shape = SubResource("RectangleShape2D_platform")

[node name="PlatformVisual" type="Polygon2D" parent="." unique_id=1382030389]
color = Color(0.6, 0.5, 0.4, 0.8)
polygon = PackedVector2Array(-32, -8, 32, -8, 32, 8, -32, 8)
